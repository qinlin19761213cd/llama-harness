<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>LlamaHarness</RootNamespace>
    <AssemblyName>Llama-harness</AssemblyName>
  </PropertyGroup>

  <!-- 静态资源（图标/文档/截图）：构建时拷贝到输出目录，运行时按 AppContext.BaseDirectory/static 加载 -->
  <ItemGroup>
    <Content Include="static/**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>


  <!-- 测试程序集可见 internal（PerfSampler 解析工具方法回归测试） -->
  <ItemGroup>
    <InternalsVisibleTo Include="LlamaHarness.Tests" />
  </ItemGroup>
</Project>
